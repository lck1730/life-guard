<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 语音消息要用。拍照不需要声明 CAMERA：
         我们是交给系统相机 App 去拍的（ACTION_IMAGE_CAPTURE），
         声明了反而在某些 ROM 上要求额外权限。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 应用内更新要用。界面能热更新，**壳不能**——壳的改动只能重装 APK，
         这个权限让"重装"不用再连电脑。系统仍会要用户点一次确认，
         静默安装需要设备管理员，没必要为自用 App 走那套。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 后台提醒（2026-10-21 加）。
         做法是**前台服务轮询** `/api/groups` + `/api/groups/{id}/messages`，
         不接厂商推送、不加任何第三方 SDK。
         · POST_NOTIFICATIONS：Android 13+ 的通知权限（运行时申请）
         · FOREGROUND_SERVICE + ..._REMOTE_MESSAGING：Android 14+ 起
           前台服务必须声明类型；`remoteMessaging` 没有 6 小时超时限制
         · RECEIVE_BOOT_COMPLETED：重启后自己把服务接上 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 引导用户去系统设置里放行后台，不再被杀。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeGuard"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- 拍照要用的 FileProvider：把缓存的临时文件以 content:// 暴露给相机 App -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 后台提醒服务。stopWithTask=false：从最近任务里划掉 App 也不停
             （用户要的是"人不在 App 里也能提醒"）。 -->
        <service
            android:name=".PushService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging"
            android:stopWithTask="false" />

        <!-- 重启 / App 更新后把服务接上。只在本机登录过（push_enabled）时才启动。 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 划掉任务后由闹钟把服务接回来。只接受自己 App 发出的显式广播。 -->
        <receiver
            android:name=".RestartReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>
</manifest>
